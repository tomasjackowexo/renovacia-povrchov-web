---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import PriceTable from '../components/PriceTable.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import LeadForm from '../components/LeadForm.astro';
import Placeholder from '../components/Placeholder.astro';
import Galeria from '../components/Galeria.astro';
import { sluzby } from '../data/sluzby';
import { galeria, heroSluzby } from '../data/fotky';
import { faqFasady, faqHroby } from '../data/faq';
import { firma } from '../data/firma';
import { recenzie, type Recenzia } from '../data/recenzie';

const recenziaPodlaSlugu: Record<string, Recenzia['sluzba'][number]> = {
  'cistenie-fasady': 'fasada',
  'cistenie-striech': 'strecha',
  'cistenie-dlazby': 'dlazba',
  'cistenie-hrobov': 'hroby',
};

export function getStaticPaths() {
  return sluzby.map((s) => ({ params: { sluzba: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const recKluc = recenziaPodlaSlugu[s.slug];
const maRecenzie = Boolean(recKluc && recenzie.some((r) => r.sluzba.includes(recKluc)));
const faqHrobove = new Set(['cistenie-hrobov', 'jednohroby', 'dvojhroby', 'pomniky', 'kamenarske-prace']);
const faqPolozky = faqHrobove.has(s.slug) ? faqHroby : faqFasady;
const f = heroSluzby[s.slug] ?? null;
---
<Base
  title={s.metaTitle}
  description={s.metaDescription}
  sluzba={{ nazov: s.nazov, cenaOd: s.cenaOd }}
  faq={faqPolozky}
  drobcekyNazov={s.nazov}
>
  <Hero
    eyebrow={s.nazov}
    nadpis={s.h1}
    perex={s.perex}
    fotka={f?.src ?? null}
    fotkaAlt={f?.alt ?? ''}
  >
    <a slot="akcie" class="btn btn-primary btn-lg" href="#formular">Chcem cenovú ponuku</a>
    <a slot="akcie" class:list={['btn', 'btn-lg', f ? 'btn-invert-ghost' : 'btn-outline']} href={firma.telefonHref}>{firma.telefon}</a>
    <div class="foto"><Placeholder popis={`${s.nazov.toLowerCase()} — reálna realizácia`} pomer="4 / 3" /></div>
  </Hero>

  <TrustBar />

  <section class="sec">
    <div class="wrap uzky">
      {s.obsah.map((b) => (
        <div class:list={['blok', { 'blok--cena': b.variant === 'cena' }]}>
          <h2>{b.nadpis}</h2>
          <p>{b.text}</p>
        </div>
      ))}
      {s.slug === 'cistenie-hrobov' && (
        <div class="blok">
          <p>Ak je kameň za hranicou renovácie, ponúkame aj nové pomníky.</p>
          <p class="odkazy">
            <a href="/jednohroby/">Jednohroby</a>
            <a href="/dvojhroby/">Dvojhroby</a>
            <a href="/pomniky/">Pomníky</a>
          </p>
        </div>
      )}
    </div>
  </section>

  <Galeria polozky={galeria[s.slug] ?? []} nadpis="Naše realizácie" />

  <section class="sec sec--sand">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Cenník</p><h2>Ceny zverejňujeme</h2></div>
      <PriceTable />
      <p class="poznamka"><a href="/cennik/">Celý cenník →</a></p>
    </div>
  </section>

  <section class="sec sec--surface">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Ako to prebieha</p><h2>Štyri kroky, žiadne prekvapenia</h2></div>
      <Steps />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Časté otázky</p><h2>Čo sa ľudia pýtajú</h2></div>
      <Faq polozky={faqPolozky} />
    </div>
  </section>

  {maRecenzie && recKluc && (
    <section class="sec sec--surface">
      <div class="wrap">
        <div class="sec-head">
          <p class="eyebrow">Recenzie</p>
          <h2>Z Google profilu</h2>
        </div>
        <Reviews polozky={recenzie} sluzba={recKluc} limit={3} />
      </div>
    </section>
  )}

  <section class="sec sec--navy">
    <div class="wrap cta-pas">
      <div>
        <h2>Obhliadka a cenová ponuka zdarma</h2>
        <p>Napíšte typ objektu a približnú plochu. Pri fasáde vieme cenu spočítať aj bez obhliadky.</p>
      </div>
      <a class="btn btn-primary btn-lg" href="#formular">Chcem cenovú ponuku</a>
    </div>
  </section>

  <section class="sec sec--surface">
    <div class="wrap uzky-form"><LeadForm nadpis={`Cenová ponuka — ${s.nazov.toLowerCase()}`} /></div>
  </section>
</Base>

<style>
  @media (max-width: 940px) { .foto { display: none; } }

  .uzky { max-width: 760px; }
  .blok + .blok { margin-top: 40px; }
  .blok h2 { font-size: clamp(22px, 2.6vw, 28px); }
  .blok p { margin-top: 12px; color: var(--muted); font-size: 16.5px; line-height: 1.7; }
  .blok--cena {
    background: var(--sand);
    border-left: 3px solid var(--navy);
    padding: 22px 24px 26px;
  }
  .blok--cena p { color: var(--text); }
  .odkazy { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .odkazy a { color: var(--navy); font-weight: 600; text-decoration: none; }
  .poznamka { margin-top: 18px; font-size: 15px; }
  .poznamka a { color: var(--navy); font-weight: 600; text-decoration: none; }
  .uzky-form { max-width: 720px; }
</style>
