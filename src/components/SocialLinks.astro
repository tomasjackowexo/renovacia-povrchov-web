---
import { firma } from '../data/firma';
const s = firma.socialne;
const odkazy = [
  { id: 'facebook', nazov: 'Facebook', url: s.facebook,
    d: 'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.92 3.77-3.92 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.9h2.78l-.45 2.91h-2.33V22c4.78-.79 8.44-4.94 8.44-9.94Z' },
  { id: 'instagram', nazov: 'Instagram', url: s.instagram,
    d: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.8 3.8 0 0 1-1.38-.9 3.8 3.8 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 3.18a6.66 6.66 0 1 0 0 13.32 6.66 6.66 0 0 0 0-13.32Zm0 10.98a4.32 4.32 0 1 1 0-8.64 4.32 4.32 0 0 1 0 8.64Zm8.48-11.24a1.56 1.56 0 1 1-3.11 0 1.56 1.56 0 0 1 3.11 0Z' },
  { id: 'youtube', nazov: 'YouTube', url: s.youtube,
    d: 'M21.58 7.19a2.5 2.5 0 0 0-1.77-1.77C18.25 5 12 5 12 5s-6.25 0-7.81.42a2.5 2.5 0 0 0-1.77 1.77C2 8.75 2 12 2 12s0 3.25.42 4.81a2.5 2.5 0 0 0 1.77 1.77C5.75 19 12 19 12 19s6.25 0 7.81-.42a2.5 2.5 0 0 0 1.77-1.77C22 15.25 22 12 22 12s0-3.25-.42-4.81ZM10 15.02V8.98L15.2 12 10 15.02Z' },
  { id: 'tiktok', nazov: 'TikTok', url: s.tiktok,
    d: 'M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.85-2.48v-3.1a5.66 5.66 0 1 0 4.94 5.6V9.01a7.35 7.35 0 0 0 4.28 1.37V7.3a4.28 4.28 0 0 1-3.22-1.48Z' },
].filter((o) => o.url);
---
{odkazy.length > 0 && (
  <ul class="soc">
    {odkazy.map((o) => (
      <li>
        <a href={o.url} target="_blank" rel="noopener noreferrer" aria-label={o.nazov}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={o.d} /></svg>
        </a>
      </li>
    ))}
  </ul>
)}
<style>
  .soc { list-style: none; margin: 0; padding: 0; display: flex; gap: 10px; }
  .soc a {
    display: grid; place-items: center; width: 40px; height: 40px; border-radius: 99px;
    border: 1px solid rgba(255, 255, 255, 0.22); color: rgba(255, 255, 255, 0.75);
    transition: background 0.16s, color 0.16s, border-color 0.16s;
  }
  .soc a:hover { background: #fff; color: var(--navy); border-color: #fff; }
  .soc a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
</style>
