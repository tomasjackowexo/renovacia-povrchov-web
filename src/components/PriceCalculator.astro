---
import { sadzby, modelovePriklady } from '../data/cennik';
---
<form class="kalk" id="kalkulacka" novalidate>
  <h3>Orientačná cena za 30 sekúnd</h3>
  <p class="sub">Vyberte službu a zadajte plochu. Presnú cenu potvrdíme po obhliadke.</p>

  <div class="field" style="margin-top:17px">
    <label for="k-sluzba">Služba</label>
    <select id="k-sluzba">
      {sadzby.map((s) => <option value={`${s.od}|${s.do}`}>{s.nazov}</option>)}
    </select>
  </div>

  <div class="field" style="margin-top:14px">
    <label for="k-plocha">Plocha fasády v m²</label>
    <input id="k-plocha" type="number" inputmode="numeric" min="10" step="10" value="120" />
  </div>

  <div class="vysledok">
    <span class="lbl">Orientačne</span>
    <span class="val" id="k-vysledok">300 – 360 €</span>
  </div>

  <p class="model">Neviete, koľko má vaša fasáda m²? {modelovePriklady[0].popis.toLowerCase()} má zvyčajne okolo {modelovePriklady[0].plocha} m² — to je {modelovePriklady[0].cena}.</p>

  <a class="btn btn-primary btn-lg" href="/kontakt/#formular" id="k-odkaz">Chcem presnú ponuku</a>
</form>

<style>
  .kalk { background: var(--surface); color: var(--text); border-radius: 6px; padding: 28px; box-shadow: var(--shadow-lift); }
  .kalk h3 { font-size: 19px; }
  .sub { font-size: 13.5px; color: var(--muted); margin-top: 7px; line-height: 1.5; }
  .vysledok { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--line); }
  .lbl { font-size: 11.5px; color: var(--muted); font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
  .val {
    display: block; font-family: var(--font-display); font-weight: 800; font-size: 30px;
    font-variant-numeric: tabular-nums; color: var(--navy); margin-top: 4px; line-height: 1.1;
  }
  .model { font-size: 13px; color: var(--muted); margin-top: 14px; line-height: 1.5; }
  .kalk .btn { width: 100%; margin-top: 16px; }
</style>

<script>
  const sel = document.getElementById('k-sluzba') as HTMLSelectElement | null;
  const plocha = document.getElementById('k-plocha') as HTMLInputElement | null;
  const out = document.getElementById('k-vysledok');
  const odkaz = document.getElementById('k-odkaz') as HTMLAnchorElement | null;
  const fmt = new Intl.NumberFormat('sk-SK', { maximumFractionDigits: 0 });

  function prepocitaj() {
    if (!sel || !plocha || !out) return;
    const [lo, hi] = sel.value.split('|').map(Number);
    const m2 = Math.max(0, Number(plocha.value) || 0);
    if (!m2) { out.textContent = 'zadajte plochu'; return; }
    out.textContent = `${fmt.format(Math.round(m2 * lo))} – ${fmt.format(Math.round(m2 * hi))} €`;
    if (odkaz) odkaz.href = `/kontakt/?plocha=${m2}#formular`;
  }
  sel?.addEventListener('change', prepocitaj);
  plocha?.addEventListener('input', prepocitaj);
  document.getElementById('kalkulacka')?.addEventListener('submit', (e) => e.preventDefault());
  prepocitaj();
</script>
