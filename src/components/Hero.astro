---
import { Picture } from 'astro:assets';
import { obrazok } from '../data/obrazky';

interface Props {
  eyebrow: string;
  nadpis: string;
  perex: string;
  usp?: string[];
  fotka?: string | null;
  fotkaAlt?: string;
}
const { eyebrow, nadpis, perex, usp, fotka = null, fotkaAlt = '' } = Astro.props;
const heroObrazok = fotka ? obrazok(fotka) : undefined;
const heroSirky = [960, 1440, 1920, 2560].filter((w) => !heroObrazok || w <= heroObrazok.width);
---
<section class:list={['hero', { 'hero--foto': Boolean(fotka) }]}>
  {heroObrazok && (
    <Picture
      class="hero-foto"
      src={heroObrazok}
      alt={fotkaAlt}
      widths={heroSirky}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: 'hero-ram' }}
    />
  )}
  {fotka && <div class="prekryv" aria-hidden="true"></div>}
  <div class="wrap">
    <div>
      <p class="eyebrow svetly">{eyebrow}</p>
      <h1 set:html={nadpis} />
      <p class="lede">{perex}</p>
      {usp && usp.length > 0 && (
        <ul class="usp">
          {usp.map((bod) => <li>{bod}</li>)}
        </ul>
      )}
      <div class="akcie"><slot name="akcie" /></div>
    </div>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(170deg, var(--cream) 0%, var(--paper) 100%);
    color: var(--text);
    overflow: hidden;
  }
  .hero--foto { background: var(--navy); color: #fff; }
  .hero-foto, :global(.hero-ram) {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
  }
  .hero-foto {
    object-fit: cover;
    object-position: 60% 40%;
  }
  .prekryv {
    position: absolute; inset: 0;
    background: linear-gradient(95deg,
      rgba(20, 52, 79, 0.97) 0%,
      rgba(20, 52, 79, 0.92) 34%,
      rgba(20, 52, 79, 0.62) 62%,
      rgba(14, 39, 57, 0.45) 100%);
  }
  .wrap {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.1fr 0.9fr;
    gap: 56px; align-items: center;
    padding-block: 64px 72px;
  }
  h1 { font-size: clamp(32px, 4.6vw, 54px); font-weight: 800; color: var(--navy); margin-top: 16px; }
  .eyebrow.svetly { color: var(--akcent); }
  .lede { margin-top: 20px; font-size: 18px; color: var(--text); max-width: 46ch; }
  .usp { list-style: none; padding: 0; margin: 30px 0 0; display: grid; gap: 12px; }
  .usp li { padding-left: 28px; position: relative; font-size: 15.5px; color: var(--text); }
  .usp li::before {
    content: ''; position: absolute; left: 0; top: 8px; width: 14px; height: 8px;
    border-left: 2.4px solid var(--akcent); border-bottom: 2.4px solid var(--akcent); transform: rotate(-45deg);
  }
  .hero--foto h1 { color: #fff; }
  .hero--foto .eyebrow.svetly { color: rgba(255, 255, 255, 0.66); }
  .hero--foto .lede { color: rgba(255, 255, 255, 0.88); }
  .hero--foto .usp li { color: #fff; }
  .hero--foto .usp li::before { border-color: #fff; }
  .akcie { display: flex; gap: 12px; margin-top: 34px; flex-wrap: wrap; }
  .akcie:empty { display: none; }

  @media (max-width: 940px) {
    .prekryv {
      background: linear-gradient(180deg,
        rgba(20, 52, 79, 0.98) 0%,
        rgba(20, 52, 79, 0.94) 42%,
        rgba(14, 39, 57, 0.88) 100%);
    }
    .wrap { grid-template-columns: 1fr; gap: 34px; padding-block: 52px 60px; }
  }
</style>
