---
interface Props {
  eyebrow: string;
  nadpis: string;
  perex: string;
  usp?: string[];
  fotka?: string | null;
  fotkaAlt?: string;
}
const { eyebrow, nadpis, perex, usp, fotka = null, fotkaAlt = '' } = Astro.props;
---
<section class="hero">
  {fotka && (
    <img
      class="hero-foto"
      src={fotka}
      alt={fotkaAlt}
      loading="eager"
      fetchpriority="high"
    />
  )}
  {fotka && <div class="prekryv" aria-hidden="true"></div>}
  <div class="wrap">
    <div>
      <p class="eyebrow svetly">{eyebrow}</p>
      <h1 set:html={nadpis} />
      <p class="lede">{perex}</p>
      {usp && usp.length > 0 && (
        <ul class="usp">
          {usp.map((bod) => <li>{bod}</li>)}
        </ul>
      )}
      <div class="akcie"><slot name="akcie" /></div>
    </div>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--navy);
    color: #fff;
    overflow: hidden;
  }
  .hero-foto {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }
  .prekryv {
    position: absolute; inset: 0;
    background: linear-gradient(95deg,
      rgba(20, 52, 79, 0.97) 0%,
      rgba(20, 52, 79, 0.92) 34%,
      rgba(20, 52, 79, 0.62) 62%,
      rgba(14, 39, 57, 0.45) 100%);
  }
  .wrap {
    position: relative; z-index: 1;
    display: grid; grid-template-columns: 1.1fr 0.9fr;
    gap: 56px; align-items: center;
    padding-block: 84px 92px;
  }
  h1 { font-size: clamp(32px, 4.6vw, 54px); font-weight: 800; color: #fff; margin-top: 16px; }
  .eyebrow.svetly { color: rgba(255, 255, 255, 0.66); }
  .lede { margin-top: 20px; font-size: 18px; color: rgba(255, 255, 255, 0.88); max-width: 46ch; }
  .usp { list-style: none; padding: 0; margin: 30px 0 0; display: grid; gap: 12px; }
  .usp li { padding-left: 28px; position: relative; font-size: 15.5px; color: #fff; }
  .usp li::before {
    content: ''; position: absolute; left: 0; top: 8px; width: 14px; height: 8px;
    border-left: 2.4px solid #fff; border-bottom: 2.4px solid #fff; transform: rotate(-45deg);
  }
  .akcie { display: flex; gap: 12px; margin-top: 34px; flex-wrap: wrap; }
  .akcie:empty { display: none; }

  @media (max-width: 940px) {
    .prekryv {
      background: linear-gradient(180deg,
        rgba(20, 52, 79, 0.98) 0%,
        rgba(20, 52, 79, 0.94) 42%,
        rgba(14, 39, 57, 0.88) 100%);
    }
    .wrap { grid-template-columns: 1fr; gap: 34px; padding-block: 52px 60px; }
  }
</style>
